# ── Telegram ─────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Optional: point the bot at a self-hosted Local Bot API server
# (needed only for files > 20 MB download / 50 MB upload).
# Example: http://localhost:8081
LOCAL_BOT_API_URL=

# For running the Local Bot API server (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Behaviour ────────────────────────────────────────────
DEFAULT_LOCALE=uz
DOWNLOAD_DIR=downloads
# Max upload size in MB. 50 = standard API. Raise to ~1900 with Local Bot API server.
MAX_FILE_MB=50

# SQLite path. Locally "musiqa.db" is fine. On Railway point it at a mounted
# Volume so caches / sessions / language prefs survive redeploys, e.g. /data/musiqa.db
DB_PATH=musiqa.db

# ── yt-dlp on cloud hosts (Railway/AWS/etc.) ─────────────
# Datacenter IPs get blocked by YouTube ("Sign in to confirm you're not a bot").
# Provide cookies and/or a (residential) proxy to make downloads reliable.
#
# LOCAL: save a Netscape cookies.txt and set its path here:
YTDLP_COOKIES_FILE=
# RAILWAY (string vars, no files): paste the WHOLE cookies.txt content here
# instead — the app writes it to a file on startup:
YTDLP_COOKIES_CONTENT=
# Residential proxy, e.g. http://user:pass@host:port  (datacenter proxies don't help)
YTDLP_PROXY=

# ── Feature keys (added as we build each feature) ────────
# Feature A/B — metadata & lyrics (free)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
GENIUS_TOKEN=

# Feature C — recognition. Shazamio needs no key. AudD is optional (paid).
AUDD_TOKEN=
