# ── Telegram ─────────────────────────────────────────────
# From @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Optional: point the bot at a self-hosted Local Bot API server. Local mode
# returns absolute paths, so the bot must share the server's state filesystem.
# docker-compose.yml wires this correctly; a remote URL alone is insufficient.
LOCAL_BOT_API_URL=

# For running the Local Bot API server (from https://my.telegram.org)
#
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Behaviour ────────────────────────────────────────────
DEFAULT_LOCALE=uz
DOWNLOAD_DIR=downloads
# Max upload size in MB. 50 = standard API. Raise to ~1900 with Local Bot API server.
MAX_FILE_MB=50
# Max incoming Telegram file the bot will download. Standard getFile caps this
# at 20 MB; raise conservatively only when LOCAL_BOT_API_URL is configured.
MAX_INPUT_MB=20
# Normally false: do not throw away messages queued during a restart.
DROP_PENDING_UPDATES=false
# Public-launch policy URL shown by /privacy. Configure it in BotFather too.
PRIVACY_POLICY_URL=

# SQLite path. Locally "musiqa.db" is fine. On Railway point it at a mounted
# Volume so caches / sessions / language prefs survive redeploys, e.g. /data/musiqa.db
DB_PATH=musiqa.db

# Hide search results longer than this many seconds (full albums/compilations
# exceed Telegram's 50 MB upload cap). Default 1200 = 20 min.
SEARCH_MAX_SECONDS=1200
# Reuse normalized YouTube searches in memory for five minutes.
SEARCH_CACHE_SECONDS=300

# ── yt-dlp on cloud hosts (Railway/AWS/etc.) ─────────────
# Datacenter IPs get blocked by YouTube ("Sign in to confirm you're not a bot").
# The Docker image already includes Deno + yt-dlp-ejs. A blocked datacenter IP
# can still need fresh login/CAPTCHA cookies and a stable, unblocked proxy. Neither
# is a guaranteed bypass; keep the same session/egress for extraction and download.
# Cookies are account credentials; use a throwaway account and follow DEPLOY.md.
#
# LOCAL: save a Netscape cookies.txt and set its path here:
# The Compose stack does not mount arbitrary host paths; use CONTENT below with
# `make api`, or add an explicit read-only secret mount yourself.
YTDLP_COOKIES_FILE=
# RAILWAY (string vars, no files): paste the WHOLE cookies.txt content here
# instead — the app writes it to a file on startup:
YTDLP_COOKIES_CONTENT=
# Authorized stable proxy with unblocked egress, e.g. http://user:pass@host:port
YTDLP_PROXY=
# Advanced cookieless yt-dlp override only. It is ignored when cookies are
# configured because yt-dlp must choose cookie-compatible clients dynamically.
YTDLP_PLAYER_CLIENT=
# Bound yt-dlp children separately from all expensive user pipelines.
YTDLP_CONCURRENCY=3
HEAVY_JOB_CONCURRENCY=3
YTDLP_SLEEP_REQUESTS=0
# Total queue + extraction + download + conversion deadline. A timed-out worker
# and all of its ffmpeg/Deno children are killed, then its staging files removed.
YTDLP_JOB_TIMEOUT_SECONDS=600
# Search/metadata should fail quickly without tying up download capacity.
YTDLP_METADATA_TIMEOUT_SECONDS=90
# Reject live streams and external media longer than this many seconds.
DOWNLOAD_MAX_SECONDS=1800

# ── Recognition fallback ─────────────────────────────────
# Shazamio needs no key. If configured, AudD is tried only when Shazamio fails
# or returns no match.
AUDD_TOKEN=
